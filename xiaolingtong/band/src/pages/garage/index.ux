.connectionRow { width:100%; height:60px; flex-direction:row; justify-content:center; align-items:center; }
.connectionDot { width:9px; height:9px; margin-right:7px; border-radius:5px; background-color:#68e5b2; }
.photoRow { width:100%; height:128px; align-items:center; justify-content:center; }
.carPhoto { width:100%; height:100%; object-fit:contain; }
.connectionText { color:#5ab9fc; text-align:center; }
.slotRow { width:100%; height:144px; padding:4px 0; flex-direction:row; justify-content:space-around; align-items:center; }
.tile { border-radius:18px; align-items:center; justify-content:center; flex-direction:column; }
.badge { width:56px; height:56px; border-radius:28px; flex-shrink:0;
  transition-property:background-color; transition-duration:180ms; transition-timing-function:ease-out; }
.pulse { animation-name:loadingPulse; animation-duration:1200ms; animation-iteration-count:infinite; animation-timing-function:ease-in-out; }
@keyframes loadingPulse {
  0% { opacity:1; }
  50% { opacity:0.45; }
  100% { opacity:1; }
}
.singleSlotRow { width:100%; height:112px; flex-direction:row; justify-content:center; align-items:center; }
.singleTile { flex-direction:row; }
.singleTileName { color:#e9edf3; width:62%; text-align:center; lines:2; text-overflow:ellipsis; }
.glyph { left:6px; top:6px; width:44px; height:44px; object-fit:contain; }
.tileName { lines:2; text-overflow:ellipsis; }
.button { width:98%; border-radius:18px; font-size:27px; text-align:center; }
.title, .number, .energyText, .tileName, .button { color:#e9edf3; }
.caption, .unit { color:#a5afbe; }
.link { color:#5ab9fc; }
.warm { color:#ffbf75; }
.tile { background-color:#192b3e; }
.button { background-color:#212a38; }
