<template>
  <stack class="page">
    <image class="skyArt" src="{{ skyImage }}"></image>
    <div class="viewport">
    <list class="feed" style="width: {{ layout.width }}; height: {{ layout.height }}" if="{{ mode === 'home' }}">
      <list-item type="vehicle" class="block headingRow">
        <text class="title">{{ vehicle }}</text>
        <text class="caption link" style="font-size: {{ layout.caption }}">{{ status }}</text>
      </list-item>
      <list-item type="range" class="range">
        <text class="number">{{ range }}</text>
        <text class="unit">{{ unit }}</text>
      </list-item>
      <list-item type="energy" class="energy" style="flex-direction: {{ layout.single ? 'column' : 'row' }}">
        <text class="energyText" style="font-size: {{ layout.caption }}">电量 {{ battery }}</text>
        <text class="energyText" style="font-size: {{ layout.caption }}">油量 {{ fuel }}</text>
      </list-item>
      <list-item type="condition" class="block conditionRow" if="{{ condition }}">
        <text class="caption" style="font-size: {{ layout.caption }}">{{ condition }}</text>
      </list-item>
      <list-item class="slotRow" style="height: {{ layout.rowHeight }}" type="actionpair" for="{{ rows }}" tid="id">
        <div class="tile" style="width: {{ layout.tileWidth }}; height: {{ layout.tileHeight }}" disabled="{{ !$item.left.enabled }}" @click="prepare($item.left.slot)">
          <div class="{{ $item.left.state === 'loading' ? 'badge pulse' : 'badge' }}" style="background-color: {{ $item.left.tint }}"><image class="glyph" src="{{ $item.left.glyph }}"></image></div>
          <text class="tileName" style="font-size: {{ layout.caption }}">{{ $item.left.controlName }}</text>
        </div>
        <div class="tile" show="{{ $item.right.slot !== '' }}" style="width: {{ layout.tileWidth }}; height: {{ layout.tileHeight }}" disabled="{{ !$item.right.enabled }}" @click="prepare($item.right.slot)">
          <div class="{{ $item.right.state === 'loading' ? 'badge pulse' : 'badge' }}" style="background-color: {{ $item.right.tint }}"><image class="glyph" src="{{ $item.right.glyph }}"></image></div>
          <text class="tileName" style="font-size: {{ layout.caption }}">{{ $item.right.controlName }}</text>
        </div>
      </list-item>
      <list-item class="block receiptRow" type="receipt">
        <text class="caption" style="font-size: {{ layout.caption }}">{{ time }}</text>
        <text class="caption warm" show="{{ !!note }}" style="font-size: {{ layout.caption }}">{{ note }}</text>
      </list-item>
      <list-item class="block buttonRow" type="theme">
        <text class="button" style="height: {{ layout.buttonHeight }}; font-size: {{ layout.buttonFont }}" @click="cycleSky">{{ skyLabel }}</text>
      </list-item>
      <list-item class="block buttonRow" type="refresh">
        <text class="button" style="height: {{ layout.buttonHeight }}; font-size: {{ layout.buttonFont }}" @click="refresh">刷新车况</text>
      </list-item>
    </list>
    <list class="feed" style="width: {{ layout.width }}; height: {{ layout.height }}" if="{{ mode === 'confirm' }}">
      <list-item class="block questionRow" type="question">
        <text class="caption link" style="font-size: {{ layout.caption }}">确认车辆操作</text>
        <div class="badge" style="background-color: {{ confirmTint }}"><image class="glyph" src="{{ confirmGlyph }}"></image></div>
        <text class="title">{{ question }}</text>
        <text class="caption" style="font-size: {{ layout.caption }}">由手机领克卡片执行</text>
      </list-item>
      <list-item class="block buttonRow" type="confirm">
        <text class="button confirmButton" style="height: {{ layout.buttonHeight }}; font-size: {{ layout.buttonFont }}" @click="confirm">确认操作</text>
      </list-item>
      <list-item class="block buttonRow" type="cancel">
        <text class="button" style="height: {{ layout.buttonHeight }}; font-size: {{ layout.buttonFont }}" @click="cancel">取消</text>
      </list-item>
    </list>
    </div>
  </stack>
</template>

<script>
const colors = {tile:'#192b3e', on:'#59cf91', loading:'#ffcc46', unknown:'#a2abb6'}
function screenLayout(info) {
  const width = Number(info.screenWidth)
  const height = Number(info.screenHeight)
  const ratio = width > 0 && height > 0 && isFinite(height / width) ? height / width : 0
  const pill = info.screenShape === 'pill-shaped' || (info.screenShape !== 'circle' && ratio >= 1.65)
  const rect = info.screenShape === 'rect' && !pill
  const rectangular = ratio > 0 && width !== height && info.screenShape !== 'circle'
  const single = pill || rectangular || !(width >= 280)
  // Center the scroll viewport inside the outline, so even its first/last row is reachable.
  // A capsule's two round ends together need just under half a screen width at 84% usable width.
  const usableHeight = pill ? 98 - Math.ceil(46 / Math.max(1, ratio)) : rect ? 94 : 66
  // Vela scales design pixels by screenWidth / designWidth (336 in the manifest).
  const designScale = width > 0 && isFinite(width) ? 336 / width : 1
  const caption = Math.max(single ? 28 : 21, Math.ceil(16 * designScale))
  const buttonHeight = Math.max(single ? 84 : 58, Math.ceil(44 * designScale))
  return {width:pill ? '84%' : rect ? '94%' : '72%', height:usableHeight + '%', single:single,
    rowHeight:Math.max(single ? 132 : 108, 48 + 3 * caption) + 12 + 'px',
    tileWidth:single ? '98%' : '48%', tileHeight:Math.max(single ? 132 : 108, 48 + 3 * caption) + 'px',
    caption:caption + 'px', buttonFont:Math.max(27, caption) + 'px', buttonHeight:buttonHeight + 'px'}
}
const icons = ['LOCK','FIND','ENGINE','TRUNK','SUNROOF','CLIMATE','WINDOW']
function controlState(item) {
  if (item.controlState !== undefined) {
    return ['open','closed','loading'].indexOf(item.controlState) >= 0 ? item.controlState : 'unknown'
  }
  // Older companions only supply a caption. Never infer state from the (opposite) action.
  const match = /\.(开|关|加载|未知)$/.exec(item.displayLabel || '')
  return match ? {'开':'open','关':'closed','加载':'loading','未知':'unknown'}[match[1]] : 'legacy'
}
function actionable(item) {
  const state = controlState(item)
  return item.enabled !== false && state !== 'loading' && state !== 'unknown'
}
function controlTile(item) {
  const state = controlState(item)
  const tint = state === 'open' ? colors.on : state === 'loading' ? colors.loading : state === 'unknown' ? colors.unknown : colors.tile
  const category = icons.indexOf(item.category) >= 0 ? item.category : 'OTHER'
  // Use the high-contrast dark glyph on the bright status badge in either theme.
  const name = typeof item.controlName === 'string' && item.controlName.trim() ||
    (typeof item.displayLabel === 'string' && item.displayLabel.replace(/\.(开|关|加载|未知)$/, '')) || item.label || '待标记'
  return {slot:item.slot, controlName:name, enabled:actionable(item), state:state, tint:tint,
    glyph:'/common/controls/' + (tint !== colors.tile ? 'day/' : '') + category + '.png'}
}
export default {
  private: {
    mode: 'home', vehicle: '小领通', status: '正在连接手机', range: '—', unit: 'km',
    condition: '', battery: '—', fuel: '—', time: '等候卡片更新', note: '',
    actions: [], rows: [], layout: screenLayout({}), question: '', confirmGlyph: '/common/controls/OTHER.png',
    skyImage:'/common/sky/night.png', skyLabel:'蓝天与星空 · 自动', skyMode:'auto',
    confirmTint: colors.tile
  },
  onInit() {
    this.userPickedSky = false
    this.updateSky()
    try {
      const store = require('@system.storage')
      if (store && store.get) store.get({key:'skyMode', success: value => {
        if (!this.userPickedSky && ['day','night','auto'].indexOf(value) >= 0) {
          this.skyMode = value
          this.updateSky()
        }
      }})
    } catch (error) { /* The bundled theme is usable without storage. */ }
    this.retries = 0
    this.fastPollUntil = 0
    this.seq = 0
    this.visible = false
    this.conn = null
    this.pending = null
    this.choice = null
    this.pollTimer = null
    this.requestTimer = null
    this.confirmTimer = null
    try {
      require('@system.device').getInfo({success: info => {
        this.layout = screenLayout(info || {})
        this.updateRows()
      }})
    } catch (error) { /* Older runtimes keep the inset, single-column default. */ }
  },
  updateSky() {
    let day = this.skyMode === 'day'
    if (this.skyMode === 'auto') {
      try {
        const hour = new Date(Date.now()).getHours()
        day = hour >= 6 && hour < 18
      } catch (error) { day = false }
    }
    this.skyImage = day ? '/common/sky/day.png' : '/common/sky/night.png'
    this.skyLabel = '蓝天与星空 · ' + ({auto:'自动',day:'日景',night:'夜景'})[this.skyMode]
  },
  cycleSky() {
    this.userPickedSky = true
    this.skyMode = ({auto:'day',day:'night',night:'auto'})[this.skyMode]
    this.updateSky()
    try {
      const store = require('@system.storage')
      if (store && store.set) store.set({key:'skyMode', value:this.skyMode})
    } catch (error) { /* Current selection remains available in memory. */ }
  },
  updateRows() {
    const columns = this.layout.single ? 1 : 2
    const tiles = this.actions.map(item => controlTile(item))
    const empty = {slot:'', controlName:'', enabled:false, tint:colors.tile, glyph:'/common/controls/OTHER.png'}
    const rows = []
    for (let i = 0; i < tiles.length; i += columns) {
      rows.push({id:tiles[i].slot, left:tiles[i], right:columns === 2 && tiles[i + 1] || empty})
    }
    // Keep the mounted badges and their animation phase on identical status replies.
    if (JSON.stringify(rows) !== JSON.stringify(this.rows)) this.rows = rows
  },
  onShow() {
    this.updateSky()
    this.visible = true
    this.retries = 0
    this.open()
  },
  onHide() { this.sleepPage() },
  onDestroy() {
    this.sleepPage()
  },
  releaseConnection() {
    if (!this.conn) return
    this.conn.onmessage = null
    this.conn.onopen = null
    this.conn.onclose = null
    this.conn.onerror = null
    this.conn = null
  },
  onBackPress() {
    if (this.mode === 'home') return false
    if (this.mode === 'confirm') this.cancel()
    else this.home()
    return true
  },
  sleepPage() {
    this.visible = false
    this.releaseConnection()
    clearTimeout(this.pollTimer)
    this.clearRequest()
    this.dropChoice()
    this.fastPollUntil = 0
    this.actions = []
    this.rows = []
    this.mode = 'home'
  },
  open() {
    if (!this.visible) return
    try {
      if (!this.conn) {
        const connection = require('@system.interconnect').instance()
        this.conn = connection
        connection.onmessage = event => { if (event) this.receive(event.data) }
        connection.onopen = () => { if (this.visible && !this.pending && !this.choice) this.send('status') }
        connection.onclose = () => this.lost('手机已断开')
        connection.onerror = () => this.lost('检查手机通信服务')
      }
      if (!this.pending && !this.choice) this.send('status')
    } catch (error) { this.lost('等待小米运动健康连接') }
  },
  schedule(delay) {
    clearTimeout(this.pollTimer)
    if (this.visible && !this.choice) this.pollTimer = setTimeout(() => this.open(), delay)
  },
  clearRequest() {
    clearTimeout(this.requestTimer)
    this.pending = null
  },
  dropChoice() {
    clearTimeout(this.confirmTimer)
    this.choice = null
    this.question = ''
  },
  lost(reason) {
    if (!this.visible) return
    const uncertain = this.pending && this.pending.type === 'execute'
    this.clearRequest()
    this.dropChoice()
    this.mode = 'home'
    this.fastPollUntil = 0
    this.actions = []
    this.rows = []
    this.status = reason
    this.note = uncertain ? '结果待核对，请查看官方车况' : ''
    this.releaseConnection()
    const delay = this.retries === 0 ? 0 : 1000 * Math.pow(2, this.retries - 1)
    this.retries = Math.min(this.retries + 1, 5)
    this.schedule(delay)
  },
  send(type, choice) {
    if (!this.visible || this.pending || !this.conn) return
    clearTimeout(this.pollTimer)
    const request = {v:1, id:Date.now().toString(36) + '_' + (++this.seq), type:type, selectedActions:true, supportsControlState:true}
    if (choice) {
      request.slot = choice.slot
      request.key = choice.key
      request.label = choice.label
      if (choice.token) request.token = choice.token
    }
    this.pending = request
    const fail = () => { if (this.pending === request) this.lost('手机未响应') }
    this.requestTimer = setTimeout(fail, 5500)
    try { this.conn.send({data:request, fail:fail}) } catch (error) { fail() }
  },
  receive(raw) {
    if (!this.visible || !this.pending) return
    let reply
    try { reply = typeof raw === 'string' ? JSON.parse(raw) : raw } catch (error) { return }
    const request = this.pending
    if (!reply || reply.v !== 1 || reply.id !== request.id) return
    this.clearRequest()
    this.retries = 0
    const s = reply.data || {}
    this.vehicle = s.vehicle || '小领通'
    this.range = s.range || '—'
    this.unit = s.unit || 'km'
    this.battery = s.battery || '—'
    this.fuel = s.fuel || '—'
    this.condition = s.condition || ''
    this.time = s.time || '等候卡片更新'
    this.status = reply.status || '手机已连接'
    this.actions = Array.isArray(reply.actions) ? reply.actions : []
    this.updateRows()
    if (reply.note) this.note = reply.note
    if (request.type === 'prepare' && reply.token && reply.label === request.label) {
      this.choice = {slot:request.slot, key:request.key, label:request.label, token:reply.token}
      const target = this.actions.find(item => item.slot === request.slot && item.key === request.key
        && item.label === request.label && actionable(item))
      if (!target) { this.dropChoice(); this.schedule(200); return }
      const tile = controlTile(target)
      this.confirmGlyph = tile.glyph
      this.confirmTint = tile.tint
      this.confirmOpened = Date.now()
      this.question = reply.label
      this.mode = 'confirm'
      this.confirmTimer = setTimeout(() => { this.note = '确认已过期'; this.cancel() }, 12000)
      return
    }
    if (request.type === 'execute') {
      this.mode = 'home'
      this.fastPollUntil = Date.now() + 5000
    }
    this.schedule(Date.now() < this.fastPollUntil ? 500 : request.type === 'refresh' ? 1600 : 5000)
  },
  refresh() {
    if (!this.conn) { this.open(); return }
    if (!this.pending) { this.note = ''; this.send('refresh') }
  },
  controls() { this.mode = 'home'; this.note = '' },
  home() {
    if (this.pending && this.pending.type === 'prepare') this.clearRequest()
    this.dropChoice()
    this.mode = 'home'
    this.note = ''
    this.schedule(200)
  },
  prepare(id) {
    if (this.pending) { this.note = '正在同步，请稍候'; return }
    const selected = this.actions.find(item => item.slot === id)
    if (selected && !actionable(selected)) { this.note = '请在手机核对动作标记和卡片状态'; return }
    if (selected) { this.note = ''; this.send('prepare', selected) }
  },
  confirm() {
    if (!this.choice || this.pending) return
    const elapsed = Date.now() - this.confirmOpened
    if (elapsed < 0 || elapsed >= 12000) { this.note = '确认已过期'; this.cancel(); return }
    if (elapsed < 500) return
    const current = this.choice
    this.dropChoice()
    this.mode = 'home'
    this.note = '等候手机回执'
    this.send('execute', current)
  },
  cancel() { this.dropChoice(); this.mode = 'home'; this.schedule(200) }
}
</script>

<style>
.page { width:100%; height:100%; background-color:#0a0d14; justify-content:center; align-items:center; }
.skyArt { width:100%; height:100%; object-fit:cover; }
.viewport { width:100%; height:100%; justify-content:center; align-items:center; }
.feed { width:72%; height:66%; flex-direction:column; }
.headingRow { width:100%; height:112px; }
.conditionRow { width:100%; height:64px; }
.receiptRow { width:100%; height:112px; }
.questionRow { width:100%; height:240px; }
.buttonRow { width:100%; height:116px; }
.block { flex-direction:column; align-items:center; padding:5px 0; }
.title, .caption, .tileName { width:100%; text-align:center; }
.title { font-size:32px; }
.caption { margin:2px 0; }
.range { width:100%; height:88px; flex-direction:row; align-items:center; justify-content:center; padding:4px 0; }
.number { font-size:55px; }
.unit { font-size:23px; margin-left:6px; }
.energy { width:100%; height:104px; justify-content:space-around; align-items:center; padding:4px 0; }
.energyText { text-align:center; }
.slotRow { width:100%; height:144px; padding:4px 0; flex-direction:row; justify-content:space-around; align-items:center; }
.tile { border-radius:18px; align-items:center; justify-content:center; flex-direction:column; }
.badge { width:48px; height:48px; border-radius:24px; align-items:center; justify-content:center;
  transition-property:background-color; transition-duration:180ms; transition-timing-function:ease-out; }
.pulse { animation-name:loadingPulse; animation-duration:1200ms; animation-iteration-count:infinite; animation-timing-function:ease-in-out; }
@keyframes loadingPulse {
  0% { opacity:1; }
  50% { opacity:0.45; }
  100% { opacity:1; }
}
.glyph { width:38px; height:38px; }
.tileName { lines:2; text-overflow:ellipsis; }
.button { width:98%; border-radius:18px; font-size:27px; text-align:center; }
.title, .number, .energyText, .tileName, .button { color:#e9edf3; }
.caption, .unit { color:#a5afbe; }
.link { color:#5ab9fc; }
.warm { color:#ffbf75; }
.tile { background-color:#192b3e; }
.button { background-color:#212a38; }
.confirmButton { background-color:#ffbf75; color:#241609; }
</style>
