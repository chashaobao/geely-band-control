<template>
  <div class="card">
    <div class="header">
      <text class="title">银河星耀 8</text>
      <text class="detail">上次车况</text>
    </div>
    <div class="hero">
      <text class="range">{{ total }} km</text>
      <image class="vehicle-image" src="/cards/garage/images/starshine-8.png"></image>
    </div>
    <div class="row">
      <text class="detail">纯电 {{ electric }} km</text>
      <text class="detail">燃油 {{ fuel }} km</text>
    </div>
    <text class="detail">{{ motion }}</text>
    <text class="detail">{{ updated }}</text>
    <div class="row buttons">
      <div class="button climate" if="{{ climateMapped }}" @click="openClimate">
        <image class="icon" src="/cards/garage/images/climate.png"></image>
        <text class="button-label">空调</text>
      </div>
      <text class="{{ climateMapped ? 'button garage' : 'button garage full-button' }}" @click="openGarage">车控</text>
    </div>
  </div>
</template>

<script>
import { rangeText, readSnapshot } from '../../common/snapshot.js'

const GARAGE = 'hap://app/com.garage.bandcontrol/garage'

export default {
  data: {
    total: '—',
    electric: '—',
    fuel: '—',
    motion: '',
    updated: '打开应用同步车况',
    climateMapped: false
  },
  onShow() {
    readSnapshot(status => {
      this.total = rangeText(status.totalKm)
      this.electric = rangeText(status.electricKm)
      this.fuel = rangeText(status.fuelKm)
      this.motion = status.motion || ''
      this.updated = status.updatedLabel ? '更新于 ' + status.updatedLabel : '车况时间未知'
      this.climateMapped = Array.isArray(status.mapped) && status.mapped.slice(0, 4).indexOf('climate') >= 0
    })
  },
  openClimate() {
    this.openPage(GARAGE + '?quickAction=climate')
  },
  openGarage() {
    this.openPage(GARAGE)
  },
  openPage(uri) {
    try {
      const router = require('@system.router')
      router.push({ uri })
    } catch (_) {
      this.updated = '请从应用列表打开'
    }
  }
}
</script>

<style>
.card {
  width: 100%;
  padding: 17px;
  flex-direction: column;
  background-color: #19232b;
  border-radius: 20px;
}
.header, .row, .hero {
  width: 100%;
  justify-content: space-between;
  align-items: center;
}
.title {
  color: #eff6f7;
  font-size: 25px;
  font-weight: bold;
}
.detail {
  color: #a4b7bd;
  font-size: 19px;
}
.range {
  color: #eff6f7;
  font-size: 40px;
  font-weight: bold;
  lines: 1;
}
.hero {
  height: 75px;
}
.vehicle-image {
  width: 138px;
  height: 70px;
  object-fit: contain;
}
.buttons {
  margin-top: 12px;
}
.button {
  width: 47%;
  height: 62px;
  border-radius: 15px;
  background-color: #26363d;
}
.full-button {
  width: 100%;
}
.climate {
  align-items: center;
  justify-content: center;
}
.garage, .button-label {
  color: #e7f3f2;
  font-size: 23px;
  text-align: center;
}
.icon {
  width: 25px;
  height: 25px;
  margin-right: 7px;
  object-fit: contain;
}
</style>
